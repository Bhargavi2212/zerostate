+// ZeroState patch p1-1: transmitter noise of +/-0.1 % of span, applied on top of
+// healthy, drift, and the non-dropped phase of dropout; never on frozen or the
+// existing noise fault mode.
+static const double ZS_NOISE_FRAC = 0.001;
+void zs_add_noise(double *measured, double span, int mode, double severity, double now_seconds) {
+    if (mode == SENSOR_FAULT_FROZEN || mode == SENSOR_FAULT_NOISE) {
+        return;
+    }
+    if (mode == SENSOR_FAULT_DROPOUT && in_dropout_phase(now_seconds, severity)) {
+        return;
+    }
+    *measured += uniform_noise(ZS_NOISE_FRAC * span);
+}
+
+// clamp to the physical range; flows below 1 % of span read 0 (low-flow cutoff)
+void zs_clamp(double *measured, double lo, double hi, bool flow_cutoff) {
+    if (flow_cutoff && *measured < 0.01 * hi) {
+        *measured = 0.0;
+    }
+    *measured = std::max(std::min(*measured, hi), lo);
+}
+
+// valve position feedback: 0 true+noise, 1 frozen, 2 true+offset+noise, 3 fixed value
+void zs_position_feedback(double true_pos, double *measured, int mode, double severity, int noise) {
+    switch (mode) {
+        case 1:
+            return;
+        case 3:
+            *measured = severity;
+            break;
+        case 2:
+            *measured = true_pos + severity + (noise ? uniform_noise(ZS_NOISE_FRAC * 100.0) : 0.0);
+            break;
+        default:
+            *measured = true_pos + (noise ? uniform_noise(ZS_NOISE_FRAC * 100.0) : 0.0);
+            break;
+    }
+    *measured = std::max(std::min(*measured, 100.0), 0.0);
+}
